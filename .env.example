# Server-side only — never prefix with VITE_ (that would bundle it into the
# client JS and expose it to anyone who opens devtools).
# Used by api/clean-ingredients.js (a Vercel serverless function) to call
# Groq's chat completions API for OCR text cleanup. Set the real value in a
# local `.env` file (gitignored) for `vercel dev`, and in your Vercel
# project's Environment Variables settings for production.
GROQ_API_KEY=
