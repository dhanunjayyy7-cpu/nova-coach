# Google AI Studio key — server-side only, never put it in the frontend.
GEMINI_API_KEY=
# Optional, defaults to gemini-3.8-flash
GEMINI_MODEL=
# Long random string used to sign login tokens.
JWT_SECRET=
PORT=3001
# Deployed frontend origin(s), comma-separated. localhost is always allowed.
FRONTEND_URL=https://labelwise-henna.vercel.app
